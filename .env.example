# Copy to .env.local and fill in from your Supabase project settings -> API.
# Without these the app runs on bundled sample data, which is clearly labelled in the UI.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# File watching: polling turns itself on when the repo sits on a /mnt/... drive,
# where inotify is unreliable. Set to 0 to force it off, 1 to force it on.
# VITE_POLL=
